# Copy to .env and fill in your values
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ntfy.sh push notifications
# 1. Install the ntfy app (iOS / Android / desktop) from https://ntfy.sh
# 2. Subscribe to your chosen topic name in the app
# 3. Set the same topic name here
NTFY_TOPIC=investment-research-alerts
NTFY_SERVER=https://ntfy.sh
NTFY_ENABLED=true

# Daily run time (24-hour, server local time)
RUN_TIME=08:00
