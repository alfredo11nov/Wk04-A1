# Copy to .env and fill in your values
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ntfy.sh push notifications
# 1. Install the free ntfy app (iOS / Android / desktop): https://ntfy.sh
# 2. Subscribe to your chosen topic name in the app
# 3. Set the same topic name here — pick something unique to you
NTFY_TOPIC=investment-research-alerts
NTFY_SERVER=https://ntfy.sh
NTFY_ENABLED=true

# Two-stage daily schedule (Asia/Singapore timezone, 24-hour format)
RESEARCH_TIME=06:00   # Financial Analyst + Fund Manager run
DELIVERY_TIME=08:00   # Admin sends briefing + push notification
